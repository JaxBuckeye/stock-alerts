# --- Pushover (optional) ---
# Set both to send push alerts. Leave both blank or commented out to log alerts only.
PUSHOVER_APP_TOKEN=your_pushover_application_token
PUSHOVER_USER_KEY=your_pushover_user_key

# --- Required ---
FINNHUB_API_KEY=your_free_finnhub_key          # https://finnhub.io/register
SEC_USER_AGENT=Your Name your@email.com        # SEC requires a contact in the User-Agent
WATCHLIST=AAPL,TSLA,NVDA,MSFT

# --- Optional (defaults shown) ---
MOVE_THRESHOLD_PCT=5
SEC_FORMS=10-Q                                 # e.g. 10-Q,10-K,8-K
PRICE_INTERVAL=60
NEWS_INTERVAL=300
HALT_INTERVAL=30
FILING_INTERVAL=300
NEWS_MAX_AGE_HOURS=6
NEWS_MAX_PER_CYCLE=3
ENABLE_NEWS=true
ENABLE_PRICES=true
ENABLE_HALTS=true
ENABLE_FILINGS=true
DRY_RUN=false                                  # true = log alerts instead of sending
LOG_LEVEL=INFO
