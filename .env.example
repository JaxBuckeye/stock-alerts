# NOTE: keep comments on their own lines. Do not put quotes or spaces around values.

# ===== Required =====
# Free key from finnhub.io
FINNHUB_API_KEY=your_finnhub_key
# SEC requires a real name + email
SEC_USER_AGENT=Your Name you@email.com

# ===== Watchlist =====
# With the Discord bot enabled, this only seeds the FIRST start; after that use /watch in Discord.
# Without the bot, this is the source of truth on every start.
WATCHLIST=AAPL,TSLA,NVDA,MSFT
MAX_TICKERS=50

# ===== Discord bot (lets people in your server add/remove tickers with slash commands) =====
# Bot token from discord.com/developers/applications > your app > Bot > Reset Token
DISCORD_BOT_TOKEN=
# Your server ID (right-click server with Developer Mode on > Copy Server ID). Makes commands appear instantly.
DISCORD_GUILD_ID=
# Optional: only members with this role ID may add/remove tickers (anyone can still use /watch list)
DISCORD_ALLOWED_ROLE_ID=
# Optional: only allow add/remove in this channel ID
DISCORD_COMMAND_CHANNEL_ID=

# ===== Per-ticker Discord channels (needs the Discord bot) =====
# Alerts for a ticker are also posted to a text channel named after it (BOLT -> #bolt).
# The bot needs View Channel, Send Messages and Embed Links in that channel.
DISCORD_TICKER_CHANNELS=true
# true = a ticker that has its own channel is NOT also posted to the general webhook channel
DISCORD_TICKER_ONLY=false
TICKER_CHANNEL_EVENTS=all

# ===== Alert channels (enable any combination, at least one) =====
# Pushover
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_EVENTS=all

# Discord alert webhook (channel > Edit > Integrations > Webhooks > Copy URL)
DISCORD_WEBHOOK_URL=
# Optional ping on halts, e.g. @here or <@YOUR_USER_ID>
DISCORD_MENTION=
DISCORD_EVENTS=all

# SMS via Twilio. Use TWILIO_FROM_NUMBER or TWILIO_MESSAGING_SERVICE_SID. Recipients in E.164, comma-separated.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_TO_NUMBERS=
# Event kinds: news, move, halt, filing, insider, stake, earnings, call, site, system (or all)
SMS_EVENTS=halt,move,filing,earnings,call

# ===== Behavior (defaults shown) =====
MOVE_THRESHOLD_PCT=5
SEC_FORMS=10-K,10-K/A,10-Q,10-Q/A,8-K,8-K/A
# Ownership filings (separate from SEC_FORMS). Alert kind: insider = Form 4, stake = 13D/13G.
# Form 4: insider buys/sells/grants by officers, directors and 10% owners
TRACK_FORM4=true
# Form 4 transaction codes to alert on, or all. P = open-market buy, S = open-market sale, A = grant,
# M = option exercise, F = tax withholding, G = gift. P,S keeps only open-market trades.
FORM4_CODES=all
# Schedule 13D: someone crossed 5% with intent to influence (activist). New 13Ds ping like halts.
TRACK_13D=true
# Schedule 13G: passive 5%+ holders (index funds etc.). Noisy, off by default.
TRACK_13G=false
# Earnings reminders: days before the report date. 1d,0d = day before and day of.
EARNINGS_REMINDERS=1d,0d
EARNINGS_REMIND_HOUR_ET=6
PRICE_INTERVAL=60
NEWS_INTERVAL=300
HALT_INTERVAL=30
FILING_INTERVAL=300
EARNINGS_INTERVAL=1800
SITE_INTERVAL=900
NEWS_MAX_AGE_HOURS=6
NEWS_MAX_PER_CYCLE=3
SITE_MAX_PER_CYCLE=3
ENABLE_NEWS=true
ENABLE_PRICES=true
ENABLE_HALTS=true
ENABLE_FILINGS=true
ENABLE_EARNINGS=true
ENABLE_SITES=true
# true = log alerts instead of sending them
DRY_RUN=false
LOG_LEVEL=INFO
